APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel Reverb (WebSocket server for live in-app notifications)
# Generate real credentials with `php artisan reverb:install`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe / Laravel Cashier
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=aud
CASHIER_CURRENCY_LOCALE=en_AU

# Billing provider
# The active payment provider. Only "stripe" is implemented.
BILLING_PROVIDER=stripe

# Payment-failure lifecycle (days)
# ACTIVE -> PAYMENT FAILED -> PAST DUE -> GRACE PERIOD -> SUSPENDED
# BILLING_PAYMENT_FAILURE_RETRY_DAYS          : window before entering grace period
# BILLING_PAYMENT_FAILURE_GRACE_PERIOD_DAYS   : access window once past due
# BILLING_PAYMENT_FAILURE_SUSPEND_AFTER_DAYS  : total window before suspension
BILLING_PAYMENT_FAILURE_RETRY_DAYS=3
BILLING_PAYMENT_FAILURE_GRACE_PERIOD_DAYS=7
BILLING_PAYMENT_FAILURE_SUSPEND_AFTER_DAYS=7

# Team onboarding invitations
# Web link lifetime for company admins / schedulers (minutes; 2880 = 48 hours).
INVITATION_WEB_EXPIRES_IN_MINUTES=2880
# One-time code the mobile app emails to employees.
INVITATION_CODE_LENGTH=6
INVITATION_CODE_EXPIRES_IN_MINUTES=15
INVITATION_CODE_MAX_ATTEMPTS=5
# Window in which a verified code may be exchanged for a password (minutes).
INVITATION_SETUP_TOKEN_EXPIRES_IN_MINUTES=30
# Store links for the "download the app" page. Leave blank until published —
# the page then shows a "coming soon" note instead of a dead link.
MOBILE_IOS_APP_URL=
MOBILE_ANDROID_APP_URL=

# Firebase Cloud Messaging (mobile push)
# ---------------------------------------------------------------------------
# FIREBASE_PROJECT          : the Firebase project id, e.g. staff-scheduling-277c9
# FIREBASE_CREDENTIALS      : path to the service account JSON, relative to the
#                             project root (this file must never be committed).
#                             Download from Firebase Console > Project settings
#                             > Service accounts > Generate new private key.
#
# FIREBASE_ANDROID_CHANNEL_ID must match the channel the mobile app registers.
# The same value appears in three places and they must all agree:
#   1. Mobile app  .env                  -> FCM_ANDROID_CHANNEL_ID
#   2. Mobile app  android/app/src/main/res/values/strings.xml
#                                        -> default_notification_channel_id
#   3. This backend .env                 -> FIREBASE_ANDROID_CHANNEL_ID
FIREBASE_PROJECT=staff-scheduling-277c9
FIREBASE_CREDENTIALS=staff-scheduling-277c9-firebase-adminsdk-fbsvc-e6c7891b0a.json

# Android notification channel (must match the mobile app).
FIREBASE_ANDROID_CHANNEL_ID=staffsaas_default
FIREBASE_ANDROID_CHANNEL_NAME=StaffSaaS
FIREBASE_ANDROID_CHANNEL_DESCRIPTION="Shift, roster and leave alerts"
FIREBASE_ANDROID_ICON=ic_notification
FIREBASE_ANDROID_COLOR=
FIREBASE_ANDROID_SOUND=default
FIREBASE_ANDROID_COLLAPSE_KEY=staffsaas_general

# iOS APNs tuning (optional; sensible defaults are applied when blank).
# FIREBASE_APNS_TOPIC            : defaults to the app bundle id.
# FIREBASE_APNS_INTERRUPTION_LEVEL: passive|active|time-sensitive|critical
FIREBASE_APNS_TOPIC=
FIREBASE_APNS_THREAD_ID=
FIREBASE_APNS_SOUND=default
FIREBASE_APNS_INTERRUPTION_LEVEL=time-sensitive
FIREBASE_APNS_PRIORITY=10

VITE_APP_NAME="${APP_NAME}"
VITE_STRIPE_KEY="${STRIPE_KEY}"

# Laravel Echo / Reverb client config (exposed to the browser bundle).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"


